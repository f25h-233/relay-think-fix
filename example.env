# Example configuration. Copy to your shell profile or set these before
# starting the proxy. None of these are required except OD_PROXY_UPSTREAM
# (or OD_PROXY_ROUTES for multiple relays).

# --- which relay to talk to ---
# A single upstream:
#   OD_PROXY_PORT=18997
#   OD_PROXY_UPSTREAM=https://your-relay.example.com
# Several relays, one listener each:
#   OD_PROXY_ROUTES=18997=relay-a.example.com,18996=relay-b.example.com

# --- the fix that matters most: nudge on tool-result turns ---
# 0 disables injection entirely.
OD_PROXY_REFLECT=1
# "tools" nudges only when the request carries tools (default); "always" is
# noisier and rarely worth it.
OD_PROXY_REFLECT_MODE=tools
# Where the nudge goes. "system" (top-level system field) is correct; "messages"
# reproduces the old broken shape where the model reads it as the user talking.
OD_PROXY_INJECT_TARGET=system

# --- retry when reasoning comes back empty ---
OD_PROXY_EMPTY_RETRY=1
OD_PROXY_EMPTY_RETRIES=3
OD_PROXY_EMPTY_MIN=10
# Only retry when the prompt is smaller than this (estimated tokens).
# A retry re-sends the whole prompt; a 500k-token session makes that expensive.
OD_PROXY_RETRY_MAX_INPUT=60000

# --- streaming decision points ---
# Thinking characters that prove the block is non-empty (release immediately).
OD_PROXY_EARLY_RELEASE=3
# Text characters that, combined with no thinking, prove the model is
# answering blind. Triggers an abort-and-retry.
OD_PROXY_ABORT_TEXT_MIN=20
# Seconds to wait for a response to finish before passing it through unjudged.
OD_PROXY_DECIDE_TIMEOUT=180

# --- diagnostics ---
OD_PROXY_LOG=                  # path to the JSONL request log; empty = default
OD_PROXY_RAW_DUMP=             # a port number or "all" to dump raw SSE frames
OD_PROXY_RAW_DIR=              # where raw frames go
